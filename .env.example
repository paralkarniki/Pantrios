# Example environment variables for Pantrio
# Copy this file to .env.local for local development or set the same values in your deployment platform.
# Never commit .env, .env.local, or any real secrets.

# OpenAI (optional)
USE_OPENAI=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# App / feature flags
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_ENABLE_TEST_USERS=false
NEXT_PUBLIC_ENABLE_DEBUG_PAGES=false
NEXT_PUBLIC_TEST_USER_PASSWORD=
NEXT_PUBLIC_ADMIN_EMAILS=
NEXT_PUBLIC_USE_EMULATOR=false

# Firebase client config (override in local/deployment env if needed)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
