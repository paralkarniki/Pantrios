rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isAdmin == true;
    }

    // Auth profiles
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId)
        && request.resource.data.isAdmin != true
        && request.resource.data.role != 'admin';
      allow update: if isAdmin() || (
        isOwner(userId)
        && request.resource.data.isAdmin == resource.data.isAdmin
        && request.resource.data.role == resource.data.role
      );
      allow delete: if isAdmin() || isOwner(userId);
    }

    // App data per user/client
    match /userData/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Login audit trail
    match /loginHistory/{docId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Security/audit events
    match /auditLogs/{docId} {
      allow create: if signedIn() && request.resource.data.actorUid == request.auth.uid;
      allow read: if isAdmin() || (signedIn() && resource.data.actorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
